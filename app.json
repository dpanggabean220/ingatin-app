{
  "expo": {
    "name": "INGATIN",
    "slug": "ingatin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ingatin",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ingatin.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ingatin.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6D4AFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Izinkan INGATIN menggunakan Face ID untuk mengunci aplikasi dan membuka sensor privasi dokumenmu."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan INGATIN mengakses galeri foto untuk melampirkan foto fisik dokumen secara lokal di perangkatmu.",
          "cameraPermission": "Izinkan INGATIN menggunakan kamera untuk memotret fisik dokumen secara lokal di perangkatmu."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Izinkan INGATIN menambahkan pengingat tanggal jatuh tempo dokumen ke Kalender perangkatmu."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Izinkan INGATIN mengakses mikrofon untuk mendiktekan nama dan catatan dokumen secara langsung.",
          "speechRecognitionPermission": "Izinkan INGATIN mengenali suara untuk mengubah ucapan menjadi teks dokumen."
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "IngatinWidget",
              "displayName": "INGATIN Status",
              "description": "Pantau masa berlaku dokumen terdekat langsung dari layar utama",
              "supportedFamilies": ["systemSmall", "systemMedium"],
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              },
              "android": {
                "minWidth": 120,
                "minHeight": 120,
                "resizeMode": "both"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
